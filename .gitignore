# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node
node_modules/
app/frontend/.vite/

# Kiln runtime
/workspace/
*.log
# Residue from running the vendored xurdif scripts from the repo root
/path_for_storing_checkpoints/
scripts/_scratch_run/

# OS
.DS_Store
Thumbs.db

# Models / data (never commit weights or datasets)
models/pretrained/*
models/fine_tuned/*
!models/pretrained/.gitkeep
!models/fine_tuned/.gitkeep
vendor/xurdif/models/*.pt

# Keep vendored engine source, ignore its sample outputs
vendor/**/results/

# Working notes and editor/agent config: kept locally, not part of the project
.claude/
/docs/
